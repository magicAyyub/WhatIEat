# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000

# Production (AWS ECS/App Runner)
# EXPO_PUBLIC_API_URL=https://fr-4fa7b86c72f1430fb04e3406f2ce4c08.ecs.eu-west-3.on.aws

# API Authentication Key
EXPO_PUBLIC_API_KEY=lemmafrappeataporte
